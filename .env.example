# --- Required ---
GROQ_API_KEY=model_api_key
DATABASE_URL=DB_URL
TAVILY_API_KEY=api_key
AVIATIONSTACK_API_KEY=api_key

# --- Recommended for production ---
APP_API_KEY=choose_a_long_random_string
PDF_BUCKET=your-s3-bucket-name
ENVIRONMENT=production

# --- Optional tuning (defaults shown) ---
PDF_URL_EXPIRY_SECONDS=86400
LOCAL_PDF_DIR=outputs
REACT_MAX_STEPS=4
REACT_TIME_BUDGET_SECONDS=45
DB_POOL_MAX_SIZE=20
